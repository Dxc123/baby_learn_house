    "asset": "audio/reading/idiom-zixiangmaodun-line-04.wav",
    "source": "macOS system speech; development demo",
    "voice": "Tingting",
    "speechText": "他发现两种说法互相冲突，一时回答不出来。",
    "textSha256": "8e2053379a2ae6da6311f023937421d0202e6feb20a76e0890b77eff34e60d52",
