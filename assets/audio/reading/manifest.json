    "asset": "audio/reading/poetry-shanxing-line-03.wav",
    "source": "macOS system speech; development demo",
    "voice": "Tingting",
    "speechText": "停车坐爱枫林晚，",
    "textSha256": "72805d98eb49b9824d50e8e499bf161e80d42b0c28f95125cc4c8b6aecf0711d",
    "audioSha256": "36f544827287cb33217e43c78d9ee3311363f55ab28a532ce4b9fa9c40671073",
