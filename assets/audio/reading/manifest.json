    "textSha256": "19e516828d14cb835f86c0abf1d3bf21d11cdde2dfe06d0cb0c0f2cf209873c2",
    "audioSha256": "d3491bd35f305aaea6a6f958acc89f397d7cb7f1d06d567a0692de472ba18877",
