    "asset": "audio/reading/poetry-shanxing-line-04.wav",
    "source": "macOS system speech; development demo",
    "voice": "Tingting",
    "speechText": "霜叶红于二月花。",
    "textSha256": "20fc2788c1aece5349edd0436b6522aab7f5e3e3e8b07766c79730c4fea5be6b",
